# --- App ---
APP_NAME=Escobar NET WhatsApp Agent
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./escobar_net.db

# --- Meta WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=cambia-este-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Si True, no llama a Meta y solo loguea (ideal para dev/testing)
WHATSAPP_DRY_RUN=True

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=512
AGENT_TIMEZONE=America/Bogota

# --- Booking / Negocio ---
BUSINESS_NAME=Escobar NET
BUSINESS_SERVICES=Desarrollo web,Aplicaciones moviles,Consultoria y cotizaciones
BUSINESS_HOURS=Lun-Sab 08:00-18:00
MEMORY_WINDOW=12
